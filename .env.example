# AssemblyAI API Key
AAI_API_KEY=your_api_key_here

# OpenAI API Key (for AI chat feature)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# Leave empty for SQLite (development), set for PostgreSQL (production)
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=

# JWT Configuration
JWT_SECRET=your_secure_random_secret_key_here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Webhooks (see WEBHOOKS.md) - leave URLs empty to disable
WEBHOOKS_ENABLED=true
# Fallback destination for every event
WEBHOOK_URL=
# Per-event destinations (optional, take priority over WEBHOOK_URL)
WEBHOOK_TRANSCRIPTION_URL=
WEBHOOK_SIGNUP_URL=
# HMAC-SHA256 signing secret (strongly recommended)
WEBHOOK_SECRET=
# Delivery tuning
WEBHOOK_TIMEOUT=5
WEBHOOK_MAX_RETRIES=3

# Optional: Legacy authentication (not needed with user registration)
# APP_USER=admin
# APP_PASS=secret

# Sign in with Google / Apple (see AUTHENTICATION.md)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=space.memomind.app

# Resend, for the e-mailed sign-in code (unset = the code is printed to the log)
RESEND_API_KEY=
MAIL_FROM=MemoMind <login@memomind.space>
