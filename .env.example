# AssemblyAI API Key
AAI_API_KEY=your_api_key_here

# Live dictation for partner apps (POST /voice/stream-token, see api/voice.py):
# comma-separated service keys, one per partner server (unset = endpoint closed)
VOICE_SERVICE_KEYS=
# Cap on each streaming session, in seconds (60 to 10800, default 180)
VOICE_MAX_SESSION_SECONDS=180

# Anthropic API key (for the AI chat feature); CHAT_MODEL overrides the default claude-sonnet-5-5
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Titles and summaries use SUMMARY_MODEL (default claude-haiku-5-5)

# Database Configuration
# Leave empty for SQLite (development), set for PostgreSQL (production)
# Example: postgresql://user:password@host:5432/database
DATABASE_URL=

# JWT Configuration
JWT_SECRET=your_secure_random_secret_key_here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Webhooks (see WEBHOOKS.md) - leave URLs empty to disable
WEBHOOKS_ENABLED=true
# Fallback destination for every event
WEBHOOK_URL=
# Per-event destinations (optional, take priority over WEBHOOK_URL)
WEBHOOK_TRANSCRIPTION_URL=
WEBHOOK_SIGNUP_URL=
# HMAC-SHA256 signing secret (strongly recommended)
WEBHOOK_SECRET=
# Delivery tuning
WEBHOOK_TIMEOUT=5
WEBHOOK_MAX_RETRIES=3

# Optional: Legacy authentication (not needed with user registration)
# APP_USER=admin
# APP_PASS=secret

# Sign in with Google / Apple (see AUTHENTICATION.md)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=space.memomind.app

# Resend, for the e-mailed sign-in code (unset = the code is printed to the log)
RESEND_API_KEY=
MAIL_FROM=MemoMind <login@memomind.space>
