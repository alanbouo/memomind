# Optional: override the API base URL (e.g. your LAN IP for local backend dev)
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Sign in with Google (needs a development build, not Expo Go).
# Web client id: the audience of the ID token; also set it in the API's GOOGLE_CLIENT_IDS.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234-abc.apps.googleusercontent.com
# iOS client id: enables the Google plugin at prebuild (iOS only).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234-def.apps.googleusercontent.com
# Sign in with Apple needs no variable here; set APPLE_CLIENT_IDS=space.memomind.app on the API.
